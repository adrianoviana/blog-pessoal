{
  "name": "adriano-viana-blog",
  "version": "1.0.0",
  "description": "Blog pessoal de Adriano Viana com posts em Markdown",
  "scripts": {
    "build": "node build-posts.js",
    "build:watch": "nodemon --watch posts -e md --exec 'node build-posts.js'",
    "dev": "concurrently \"nodemon --watch posts -e md --exec 'node build-posts.js'\" \"browser-sync start --server --port 8080 --files 'blog,js,css,posts.json,*.html' --no-open\""
  },
  "keywords": [
    "blog",
    "markdown",
    "static-site"
  ],
  "author": "Adriano Viana",
  "license": "MIT",
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^11.1.1"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.11"
  }
}
